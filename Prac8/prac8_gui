package prac_9;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.sql.*;

public class Prac_9 extends JFrame implements ActionListener {

    JTextField id, name, course, age;

    JButton submit;

    Prac_9() {

        setTitle("Student Record");
        setSize(500, 350);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        // Main panel
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(25, 30, 25, 30));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 10, 10, 10);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Student ID
        gbc.gridx = 0;
        gbc.gridy = 0;
        gbc.weightx = 0;
        panel.add(new JLabel("Student ID:"), gbc);

        id = new JTextField(20);
        gbc.gridx = 1;
        gbc.weightx = 1;
        panel.add(id, gbc);

        // Name
        gbc.gridx = 0;
        gbc.gridy = 1;
        gbc.weightx = 0;
        panel.add(new JLabel("Name:"), gbc);

        name = new JTextField(20);
        gbc.gridx = 1;
        gbc.weightx = 1;
        panel.add(name, gbc);

        // Course

        gbc.gridx = 0;
        gbc.gridy = 2;
        gbc.weightx = 0;
        panel.add(new JLabel("Course:"), gbc);

        course = new JTextField(20);
        gbc.gridx = 1;
        gbc.weightx = 1;
        panel.add(course, gbc);

        // Age
        gbc.gridx = 0;
        gbc.gridy = 3;
        gbc.weightx = 0;
        panel.add(new JLabel("Age:"), gbc);

        age = new JTextField(20);
        gbc.gridx = 1;
        gbc.weightx = 1;
        panel.add(age, gbc);

        // Submit button
        submit = new JButton("Submit");
        submit.addActionListener(this);

        gbc.gridx = 1;
        gbc.gridy = 4;
        gbc.weightx = 0;
        gbc.anchor = GridBagConstraints.CENTER;
        gbc.fill = GridBagConstraints.NONE;

        panel.add(submit, gbc);

        add(panel);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {

        try {

            Connection con = DriverManager.getConnection(
                    "jdbc:mysql://localhost:3306/college",
                    "root",
                    "root123"
            );

            String sql = "INSERT INTO student VALUES (?, ?, ?, ?)";

            PreparedStatement ps = con.prepareStatement(sql);

            ps.setInt(1, Integer.parseInt(id.getText()));
            ps.setString(2, name.getText());
            ps.setString(3, course.getText());
            ps.setInt(4, Integer.parseInt(age.getText()));

            ps.executeUpdate();

            JOptionPane.showMessageDialog(
                    this,
                    "Record inserted successfully!"
            );

            id.setText("");
            name.setText("");
            course.setText("");
            age.setText("");

            ps.close();
            con.close();

        } catch (Exception ex) {
            JOptionPane.showMessageDialog(
                    this,
                    "Error: " + ex.getMessage()
            );
        }
    }

    public static void main(String[] args) {
        new Prac_9();
    }
}
